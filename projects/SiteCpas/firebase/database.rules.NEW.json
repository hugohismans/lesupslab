{
  "rules": {
    "orgs": {
      // Phase 3 — Lecture toujours auth != null (temps réel Firebase
      // indispensable pour calendrier / files). Écriture : "auth != null"
      // par défaut, mais chirurgicalement refusée (false) sur les paths
      // sensibles migrés sur le Worker. Le service account du Worker
      // bypass toutes les rules → il peut toujours écrire ces paths.
      // Phase 3bis : élargir le blocage quand superadmin + kiosk seront
      // aussi migrés sur le Worker.
      ".read": "auth != null",
      "$orgId": {
        ".read": "auth != null",
        ".write": "auth != null",

        // ── Configuration (appConfig) ─────────────────────────────
        // Phase 3 + 3bis + 3ter — tout appConfig migré sur le Worker
        // (admin-only via /data/write avec authz ; champs self-scope
        // agent autorisés selon SCOPED_RULES). Le service account
        // bypass les Rules pour permettre ces écritures.
        "appConfig": {
          ".validate": "newData.exists()",
          "agents":    { ".validate": "newData.exists()" },
          "lieux":     { ".validate": "newData.exists()" },
          "services":  { ".validate": "newData.exists()" },
          "agentPasswords":  { ".write": false },
          "agentRoles":      { ".write": false },
          "agentColors":     { ".write": false },
          "agentEmojis":     { ".write": false },
          "agentGenders":    { ".write": false },
          "agentPublicNames":{ ".write": false },
          "agentPermRoles":  { ".write": false }
        },

        // ── Réservations : CRUD migré sur le Worker (Phase 3) ────
        "reservations": {
          ".write": false,
          "$resId": {
            ".validate": "!newData.exists() || newData.hasChildren(['localId', 'startDateTime'])",
            "note":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 10000)" },
            "agent": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 500)" }
          }
        },

        // ── État temps réel (appState) ────────────────────────────
        // appointmentRequests migré sur le Worker (Phase 3bis).
        "appState": {
          "appointmentRequests": {
            ".write": false,
            "$reqId": {
              ".validate": "!newData.exists() || newData.hasChildren(['targetAgentKey', 'requesterAgentKey'])",
              "message": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 10000)" }
            }
          }
        },

        // ── Notifications : plafond de taille + index pour perf ───
        "notifications": {
          ".indexOn": ["createdAt"],
          "$agentKey": {
            ".indexOn": ["createdAt"],
            "$notifId": {
              "message": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 2000)" }
            }
          }
        },

        // ── Requêtes techniques : CRUD migré sur le Worker ────────
        "requests": {
          ".write": false,
          "$reqId": {
            "description": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 10000)" }
          }
        },

        // ── Planning : CRUD migré sur le Worker ───────────────────
        "planning": {
          ".write": false,
          "$taskId": {
            "title": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 500)" },
            "notes": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 10000)" }
          }
        },

        // ── Audit log (Phase 0.4) ─────────────────────────────────
        // Append-only côté client — les agents peuvent écrire une entrée
        // mais jamais la modifier ni la supprimer (gardé pour forensique).
        // La lecture est nécessaire pour la vue "Journal" côté admin.
        // La vraie restriction de lecture viendra en Phase 2+ via le Worker.
        "audit": {
          ".read": "auth != null",
          ".indexOn": ["ts"],
          "$entry": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['ts', 'action']) && newData.child('action').isString() && newData.child('action').val().length < 100 && newData.child('ts').isNumber()"
          }
        }
      }
    },

    // ── Superadmin (Phase 3bis) ───────────────────────────────────
    // Read : auth requise (anonymous OK) — avant : public. Les pages
    // onboarding.html / docs-admin.html font déjà signInAnonymously()
    // donc elles continuent de fonctionner.
    // Write : bloquée (false) → passe par le Worker (service account
    // qui bypass les Rules). Le passwordHash est lisible uniquement
    // par le service account. Exception : bootstrap du 1er mdp
    // superadmin tant qu'il n'existe pas encore (pour éviter de
    // devoir créer une org vide à la main dans Firebase Console).
    "superadmin": {
      ".read":  "auth != null",
      ".write": false,
      "passwordHash": {
        ".read":  false,
        ".write": "auth != null && !data.exists()"
      }
    },

    // ── TOUT LE RESTE → INTERDIT ──────────────────────────────────
    ".read": false,
    ".write": false
  }
}
